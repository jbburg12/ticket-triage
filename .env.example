# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Required for anything that calls the model (run, eval, label, agreement).
# Create one at https://platform.claude.com, and set a monthly spend limit there.
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing. Leave empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps your local traces apart from CI's ("ci") in the Langfuse UI.
LANGFUSE_TRACING_ENVIRONMENT=development
